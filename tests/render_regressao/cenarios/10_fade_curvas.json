{
  "schema": 1,
  "id": "10_fade_curvas",
  "descricao": "Cor sólida com fade in/out em todas as curvas paramétricas de fade.py",
  "marcadores": ["render_golden", "paridade"],
  "fps": 24,
  "resolucao": [320, 180],
  "fontes": {},
  "sequencia": {
    "version": 2,
    "fps": 24,
    "width": 320,
    "height": 180,
    "tracks": [{"id": "V1", "kind": "video", "order": 0}],
    "clips": [
      {
        "id": "matte_fade",
        "type": "video",
        "kind": "color_matte",
        "color": "#ffffff",
        "track": "V1",
        "timeline_start": 0.0,
        "in": 0.0,
        "out": 3.0,
        "effects": [
          {"type": "fit", "mode": "fill"},
          {"type": "crossfade", "side": "in", "duration_s": 1.0, "curve": "s_curve", "tension": 0.4},
          {"type": "crossfade", "side": "out", "duration_s": 1.0, "curve": "exponential", "tension": 0.0}
        ]
      }
    ]
  },
  "pedido": {"kind": "master", "faixa": null, "overrides": {"mute_audio": true}}
}
