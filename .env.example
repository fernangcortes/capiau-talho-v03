# ─────────────────────────────────────────────────────────────────────────────
# CapIAu-Talho — Modelo de Configuração (.env)
#
# Copie este arquivo para `.env` e preencha os valores:
#     cp .env.example .env
#
# O `.env` é ignorado pelo Git de propósito: ele contém segredos e chaves.
# Documentação completa: seção "Configuração" do README.md
# ─────────────────────────────────────────────────────────────────────────────


# ── Chaves de API (Obrigatórias para Nuvem) ──────────────────────────────────

# OpenRouter: IA de texto (resumos, temas, sugestões de corte) e visão multimodal
# Obtenha em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# AssemblyAI: Transcrição de fala com diarização em pt-BR
# Obtenha em: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=


# ── Chaves de API Opcionais / Motores Alternativos ───────────────────────────
# Também ajustáveis pela interface em: Configurações › Modelos & Chaves

# Transcrição alternativa Nova-3 (nuvem) — https://console.deepgram.com
DEEPGRAM_API_KEY=

# Sistema 1 de triagem ultra-rápida (Jev em nuvem) — https://console.typesafe.ai
TYPESAFE_API_KEY=

# Tratamento profissional de áudio (dereverb, autoEQ, denoise — 2h/mês grátis)
# https://auphonic.com/
AUPHONIC_API_KEY=

# Hugging Face: Necessário para baixar modelos locais restritos/gated (ex.: diarização pyannote)
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=

# Chaves diretas de provedores (caso prefira inferência direta sem OpenRouter):
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# NVIDIA_NIM_KEY=


# ── Modelos de IA ────────────────────────────────────────────────────────────
# Todos ajustáveis pelo painel de configurações (o painel TEM prioridade sobre o .env).

# Resumos, temas, sugestões de timeline e chat.
# Opções na OpenRouter:
#   - Versão pontual estável: deepseek/deepseek-v4.1-flash (padrão recomendado)
#   - Alias automático (sempre o mais novo lançado): ~deepseek/deepseek-flash-latest
#   - Alta precisão / raciocínio: deepseek/deepseek-v4-pro
#   - Outros: google/gemini-3.8-flash, anthropic/claude-sonnet-5.5
# Caso use a API oficial direta da DeepSeek (DEEPSEEK_API_KEY — https://api-docs.deepseek.com):
#   - deepseek-flash (nome canônico oficial para o V4.1-Flash) ou deepseek-chat
TEXT_MODEL=deepseek/deepseek-v4.1-flash

# Decupagem e descrição de frames de vídeo e fotos de set (OpenRouter).
# Opções comuns: google/gemini-2.5-flash, google/gemini-3.8-flash, google/gemini-3.1-flash-lite
VISION_MODEL=google/gemini-2.5-flash

# Modelo reserva de visão: acionado só depois que o modelo principal falha consecutivamente.
# Deve ser um modelo ativo na OpenRouter (a versão antiga nano-12b-v2 foi descontinuada).
VISION_MODEL_FALLBACK=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Tentativas no modelo principal antes de cair para a reserva (1 a 5).
VISION_MAX_RETRIES=2

# Modelo do assistente que edita a timeline por comandos de chat.
# Opções: deepseek/deepseek-v4.1-flash, ~deepseek/deepseek-flash-latest, deepseek-flash, deepseek/deepseek-v4-pro
AGENT_MODEL=deepseek/deepseek-v4.1-flash

# Embeddings de texto locais (busca semântica).
# Ao alterar, execute: POST /api/search/reindex para reindexar o acervo.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2


# ── Desempenho e Conversão ───────────────────────────────────────────────────

# Número de conversões de proxy em paralelo (ex.: 2 para 4 núcleos, 6 para 8+ núcleos).
MAX_CONVERSION_WORKERS=2


# ── Armazenamento Remoto S3 (Opcional) ───────────────────────────────────────
# Deixe USE_S3_STORAGE=false para manter proxies e miniaturas apenas no disco local.
USE_S3_STORAGE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=capiau-talho-storage


# ── Reconhecimento Facial em Nuvem (Opcional) ────────────────────────────────
# Alternativa aos motores locais (YuNet + SFace), que rodam em CPU sem custo.

# Tier 1 — Azure Face API (30.000 chamadas gratuitas/mês):
# AZURE_FACE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com
# AZURE_FACE_KEY=


# ── Caminhos e Diretórios Locais (Opcionais) ─────────────────────────────────
# Descomente apenas se desejar personalizar pastas fora do padrão data/ e watch/.

# CAPIAU_DB_PATH=data/capiau.db
# CAPIAU_WATCH=watch
# CAPIAU_ORIGINALS=data/originals
# CAPIAU_PROXIES=data/proxies
# CAPIAU_CACHE=data/cache
# CAPIAU_EXPORTS_DIR=data/exports
# CAPIAU_QDRANT_DB=data/qdrant.db
