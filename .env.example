# ─────────────────────────────────────────────────────────────────────────────
# CapIAu-Talho — modelo de configuração
#
# Copie este arquivo para `.env` e preencha os valores.
# O `.env` é ignorado pelo Git de propósito: ele contém segredos.
#
#     cp .env.example .env
#
# Documentação completa: seção "Configuração" do README.md
# ─────────────────────────────────────────────────────────────────────────────


# ── Chaves de API (obrigatórias) ─────────────────────────────────────────────

# Descrições visuais, temas, resumos e agente de edição — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Transcrição com diarização em pt-BR — https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=


# ── Modelos de IA ────────────────────────────────────────────────────────────
# Todos ajustáveis também pelo painel de configurações da interface.
# Atenção: o valor salvo no painel TEM PRIORIDADE sobre o definido aqui.

# Resumos, temas, sugestões de timeline e chat.
# deepseek/deepseek-v4-pro entrega melhor qualidade a um custo maior.
TEXT_MODEL=deepseek/deepseek-v4-flash

# Descrição de frames de vídeo e fotos de set.
VISION_MODEL=google/gemini-2.5-flash

# Modelo reserva de visão: entra em ação só depois que o principal falha.
VISION_MODEL_FALLBACK=nvidia/nemotron-nano-12b-v2-vl:free

# Tentativas no modelo principal antes de cair para a reserva.
VISION_MAX_RETRIES=2

# Modelo do agente que edita a timeline por comandos de chat.
AGENT_MODEL=deepseek/deepseek-v4-flash

# Embeddings de texto (busca semântica).
# Ao trocar, rode POST /api/search/reindex para reindexar o acervo.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2


# ── Desempenho ───────────────────────────────────────────────────────────────

# Conversões de proxy em paralelo. Ex.: 6 para um i7-10700.
MAX_CONVERSION_WORKERS=2


# ── Caminhos locais (opcionais) ──────────────────────────────────────────────
# Descomente apenas se quiser mudar os padrões.

# CAPIAU_DB_PATH=data/capiau.db
# CAPIAU_EXPORTS_DIR=data/exports


# ── Armazenamento remoto S3 (opcional) ───────────────────────────────────────
# Deixe USE_S3_STORAGE=false para manter proxies e miniaturas só no disco local.

USE_S3_STORAGE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=


# ── Reconhecimento facial em nuvem (opcional) ────────────────────────────────
# Alternativa ao motor local YuNet + SFace, que roda em CPU sem custo.

# AZURE_FACE_ENDPOINT=
# AZURE_FACE_KEY=
